# Copy this file to .env.local and fill in your values

# n8n webhook URL for form submission
# Get this from n8n after importing legal-ai-form-submit.json
# Format: https://your-n8n-instance.app.n8n.cloud/webhook/form-submit
VITE_N8N_WEBHOOK_URL=

# preview-module G5 (#83) — preview-pay webhook (the «Сплатити» step).
# OPTIONAL: if unset, the client derives it from VITE_N8N_WEBHOOK_URL by swapping
# the path segment (…/webhook/form-submit → …/webhook/preview-pay). Set explicitly
# only if the two workflows live on different bases.
VITE_N8N_PREVIEW_PAY_URL=

# Supabase — for loading form_config dynamically
# Find in: Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public client app (Telegram Mini App) base URL — the admin "Форма клієнта" links open here.
# The admin is a separate origin, so these links must be absolute. Defaults to the prod client
# (https://legal-twa-xi.vercel.app) if unset; set to http://localhost:5173 for local dev.
VITE_CLIENT_URL=

# ── Scripts only (not exposed to browser) ──────────────────────────────────────

# Supabase service_role key — for scripts that write to DB (seed-divorce-laws, update-form-configs)
# Find in: Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_KEY=

# Google Gemini API key — for text-embedding-004 (RAG vectorization)
# Get from: https://aistudio.google.com/app/apikey
# Used in: scripts/seed-divorce-laws.ts
# Model: text-embedding-004 (768 dims) — upgrade to gemini-embedding-exp-03-07 (3072 dims) later
GEMINI_API_KEY=

# AES-256 encryption key for cases.encrypted_data (PII protection)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used in: n8n Global Config node + scripts/decrypt-case.mjs
ENCRYPTION_KEY=
