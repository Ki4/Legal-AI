{
  "name": "legal-twa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:admin": "vite --config vite.config.admin.ts --port 5174",
    "build:admin": "tsc -b && vite build --config vite.config.admin.ts && node -e \"import('fs').then(f=>f.renameSync('dist-admin/admin.html','dist-admin/index.html'))\"",
    "preview:admin": "vite preview --config vite.config.admin.ts --port 5174",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:docs": "node scripts/test-document.mjs",
    "test:docs:update": "node scripts/test-document.mjs --update-golden",
    "check:laws": "node scripts/check-law-updates.mjs",
    "check:laws:dry": "node scripts/check-law-updates.mjs --dry-run",
    "scaffold": "node scripts/scaffold-service.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "@twa-dev/sdk": "^8.0.2",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.4"
  }
}
