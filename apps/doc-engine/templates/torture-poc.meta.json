        { "value": "Розписка про отримання коштів", "label": "Розписка про отримання коштів" },
        { "value": "Банківська виписка", "label": "Банківська виписка" },
        { "value": "Листування сторін", "label": "Листування сторін" }
      ],
      "hint": "Живить табличний цикл {%tr for ... %} — рядки таблиці множаться за кількістю обраних."
