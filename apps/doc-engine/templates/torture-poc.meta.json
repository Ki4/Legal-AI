    {
      "id": "filing_date",
      "tab": "case",
      "type": "date",
      "label": "Дата подання",
      "required": true,
      "hint": "Друкується прописом над підписом; абзац має keep_with_next."
    },

    { "id": "last_name", "tab": "plaintiff", "type": "text", "label": "Прізвище", "required": true, "validation": "name" },
    { "id": "first_name", "tab": "plaintiff", "type": "text", "label": "Ім'я", "required": true, "validation": "name" },
    { "id": "middle_name", "tab": "plaintiff", "type": "text", "label": "По батькові", "required": true, "validation": "name" },
    { "id": "birth_date", "tab": "plaintiff", "type": "date", "label": "Дата народження", "required": true },
    { "id": "registered_address", "tab": "plaintiff", "type": "text", "label": "Адреса реєстрації", "required": true },

    { "id": "defendant_last_name", "tab": "defendant", "type": "text", "label": "Прізвище відповідача", "required": true, "validation": "name" },
    { "id": "defendant_first_name", "tab": "defendant", "type": "text", "label": "Ім'я відповідача", "required": true, "validation": "name" },
    { "id": "defendant_middle_name", "tab": "defendant", "type": "text", "label": "По батькові відповідача", "required": true, "validation": "name" },
    { "id": "defendant_registered_address", "tab": "defendant", "type": "text", "label": "Адреса реєстрації відповідача", "required": true },
    {
      "id": "defendant_birth_date",
      "tab": "defendant",
      "type": "date",
      "label": "Дата народження відповідача",
      "required": false,
      "hint": "Опційне. ЦЕ САМЕ ТЕ поле, на якому рушій A друкував '________ року народження' (знахідка A з демо D7)."
