        "jsCode": "// Inline-button taps (Ask Confirm Так/Ні, 🔄 Інша послуга) only ever reach a\n// user who already exists, so this is never the user's first message.\nconst norm = $('Normalize').item.json;\nconst data = norm._text || '';\nlet action = 'show_menu';\nlet serviceId = null;\nif (data.startsWith('confirm_service_')) {\n  action = 'confirm_service';\n  serviceId = Number(data.slice('confirm_service_'.length));\n}\nreturn [{ json: { ...norm, _is_new: false, _callback_action: action, service_id_parsed: serviceId } }];"
