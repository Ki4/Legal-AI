      "parameters": {
        "jsCode": "// Normalize: works for both message and callback_query events\nconst data = $input.first().json;\nconst cb = data.callback_query;\nconst msg = data.message;\n\nreturn [{\n  json: {\n    ...data,\n    _chatId:     cb ? cb.message.chat.id         : msg?.chat.id,\n    _userId:     String(cb ? cb.from.id          : msg?.from?.id || ''),\n    _text:       cb ? cb.data                    : (msg?.text || ''),\n    _firstName:  cb ? cb.from.first_name         : (msg?.from?.first_name || 'Клієнт'),\n    _type:       cb ? 'callback_query'           : 'message'\n  }\n}];"
      },
      "id": "normalize-001",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
