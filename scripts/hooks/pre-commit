#!/bin/bash
# Pre-commit hook: блокирует коммиты с захардкоженными секретами.
# Установка: bash scripts/setup-hooks.sh

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Паттерны секретов для блокировки
# Паттерны намеренно разбиты на части чтобы не триггерить сами себя
JWT_PREFIX='eyJhbGci'
JWT_SUFFIX='OiJIUzI1NiIsInR5cCI6IkpXVCJ9'
PATTERNS=(
    "${JWT_PREFIX}${JWT_SUFFIX}"   # JWT HS256 (Supabase legacy keys)
    'AIzaSy[0-9A-Za-z_-]{33}'     # Google API key
    'sb_secret_[0-9A-Za-z_-]+'    # Supabase новый secret key
    'sk-ant-[0-9A-Za-z_-]+'       # Anthropic API key
    'sk-[0-9A-Za-z_-]{40,}'       # OpenAI API key
)

# Файлы и пути которые пропускаем (false positives)
SKIP_PATTERN='\.(png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|pptx|lock|map|bin)$|\.env\.example$|docs/runbooks/secrets|scripts/hooks/'

FOUND=0
STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)

for file in $STAGED; do
    if echo "$file" | grep -qE "$SKIP_PATTERN"; then
        continue
    fi

    content=$(git show ":$file" 2>/dev/null) || continue

    for pattern in "${PATTERNS[@]}"; do
        if echo "$content" | grep -qE "$pattern"; then
            echo -e "${RED}BLOCKED${NC}: секрет в файле ${YELLOW}$file${NC}"
            echo "         паттерн: $pattern"
            FOUND=1
            break
        fi
    done
done

if [ "$FOUND" -eq 1 ]; then
    echo ""
    echo "Коммит отменён. Секреты должны быть в .env.local (gitignored)."
    echo "Инструкция: docs/runbooks/secrets-management.md"
    exit 1
fi

exit 0
